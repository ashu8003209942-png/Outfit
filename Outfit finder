local RESULT = ""

local function splitIds(str)

	local t = {}

	if not str then
		return t
	end

	for id in string.gmatch(str,"%d+") do
		table.insert(t, tonumber(id))
	end

	return t
end

local function extractTemplateId(str)

	if not str then
		return 0
	end

	local found = tostring(str):match("%d+")

	if found then
		return tonumber(found)
	end

	return 0
end

