---------------------------------------------------
-- SCAN
---------------------------------------------------

scan.MouseButton1Click:Connect(function()

	local char = plr.Character or plr.CharacterAdded:Wait()

	local hum = char:FindFirstChildOfClass("Humanoid")

	if not hum then
		return
	end

	local desc = hum:GetAppliedDescription()

	local accessories = {}

	local function add(tbl)

		for _,id in ipairs(tbl) do

			if not table.find(accessories,id) then
				table.insert(accessories,id)
			end
		end
	end

	---------------------------------------------------
	-- ACCESSORIES
	---------------------------------------------------

	pcall(function() add(splitIds(desc.HatAccessory)) end)
	pcall(function() add(splitIds(desc.HairAccessory)) end)
	pcall(function() add(splitIds(desc.FaceAccessory)) end)
	pcall(function() add(splitIds(desc.BackAccessory)) end)
	pcall(function() add(splitIds(desc.FrontAccessory)) end)
	pcall(function() add(splitIds(desc.NeckAccessory)) end)
	pcall(function() add(splitIds(desc.WaistAccessory)) end)

	pcall(function()

		if desc.LeftShoulderAccessory then
			add(splitIds(desc.LeftShoulderAccessory))
		end

		if desc.RightShoulderAccessory then
			add(splitIds(desc.RightShoulderAccessory))
		end
	end)

	---------------------------------------------------
	-- CLOTHES
	---------------------------------------------------

	local shirtId = 0
	local pantsId = 0

	local shirt = char:FindFirstChildOfClass("Shirt")
	local pants = char:FindFirstChildOfClass("Pants")

	if shirt then
		shirtId = extractTemplateId(shirt.ShirtTemplate)
	end

	if pants then
		pantsId = extractTemplateId(pants.PantsTemplate)
	end

	---------------------------------------------------
	-- BODY PART IDS
	---------------------------------------------------

	local body = {
		Head = desc.Head or 0,
		Torso = desc.Torso or 0,
		LeftArm = desc.LeftArm or 0,
		RightArm = desc.RightArm or 0,
		LeftLeg = desc.LeftLeg or 0,
		RightLeg = desc.RightLeg or 0,
	}

	---------------------------------------------------
	-- RESULT
	---------------------------------------------------

	local txt = "Accessories = {\n"

	for _,id in ipairs(accessories) do
		txt = txt.."    "..id..",\n"
	end

	txt = txt..
"}\n\n"..
"Shirt = "..shirtId.."\n"..
"Pants = "..pantsId.."\n\n"..

"Body = {\n"..
"    Head = "..body.Head..",\n"..
"    Torso = "..body.Torso..",\n"..
"    LeftArm = "..body.LeftArm..",\n"..
"    RightArm = "..body.RightArm..",\n"..
"    LeftLeg = "..body.LeftLeg..",\n"..
"    RightLeg = "..body.RightLeg.."\n"..
"}\n\n"..

"Scales = {\n"..
"    Height = "..desc.HeightScale..",\n"..
"    Width = "..desc.WidthScale..",\n"..
"    Depth = "..desc.DepthScale..",\n"..
"    Head = "..desc.HeadScale.."\n"..
"}"

	RESULT = txt
	box.Text = txt
end)
