---------------------------------------------------
-- CLEAR
---------------------------------------------------

local function clear()

	for _,v in ipairs(char:GetChildren()) do

		if v:IsA("Accessory")
		or v:IsA("Shirt")
		or v:IsA("Pants")
		or v:IsA("ShirtGraphic") then

			v:Destroy()
		end
	end

	for _,v in ipairs(char:GetDescendants()) do

		if v:IsA("WrapLayer")
		or v:IsA("WrapTarget") then

			pcall(function()
				v:Destroy()
			end)
		end
	end
end

---------------------------------------------------
-- HK
---------------------------------------------------

local function applyHK()

	local head = char:FindFirstChild("Head")

	if head then

		head.Transparency = 1

		for _,v in ipairs(head:GetChildren()) do
			if v:IsA("Decal") then
				v.Transparency = 1
			end
		end
	end

	local limbs = {
		{"RightLowerLeg",902942093,true},
		{"RightUpperLeg",902942096,false,902843398},
		{"RightFoot",902942089,true}
	}

	for _,info in ipairs(limbs) do

		local p = char:FindFirstChild(info[1])

		if p then

			p.MeshId = "rbxassetid://"..info[2]

			if info[3] then
				p.Transparency = 1
			end

			if info[4] then
				p.TextureID = "rbxassetid://"..info[4]
			end
		end
	end
end

---------------------------------------------------
-- ACCESSORY ATTACH
---------------------------------------------------

local function attachAccessory(acc)

	local handle = acc:FindFirstChild("Handle")
	if not handle then return end

	handle.Anchored = false
	handle.CanCollide = false
	handle.Massless = true

	local attachment = handle:FindFirstChildWhichIsA("Attachment")
	if not attachment then return end

	for _,part in ipairs(char:GetDescendants()) do

		local charAttachment = part:FindFirstChild(attachment.Name)

		if charAttachment then

			handle.CFrame =
				charAttachment.WorldCFrame *
				attachment.CFrame:Inverse()

			local weld = Instance.new("WeldConstraint")
			weld.Part0 = handle
			weld.Part1 = part
			weld.Parent = handle

			acc.Parent = char
			return
		end
	end
end

---------------------------------------------------
-- EQUIP
---------------------------------------------------

local function equip(id)

	task.spawn(function()

		local ok,model = pcall(function()
			return game:GetObjects("rbxassetid://"..id)
		end)

		if not ok or not model or not model[1] then
			return
		end

		local obj = model[1]

		local accessory

		if obj:IsA("Accessory") then
			accessory = obj
		else
			accessory = obj:FindFirstChildWhichIsA("Accessory",true)
		end

		if accessory then
			pcall(function()
				attachAccessory(accessory)
			end)
		end
	end)
end

---------------------------------------------------
-- BODY
---------------------------------------------------

local function applyBody(body,scales)

	local hum = char:FindFirstChildOfClass("Humanoid")

	if hum then

		pcall(function()

			if hum:FindFirstChild("BodyHeightScale") then
				hum.BodyHeightScale.Value = scales.Height
			end

			if hum:FindFirstChild("BodyWidthScale") then
				hum.BodyWidthScale.Value = scales.Width
			end

			if hum:FindFirstChild("BodyDepthScale") then
				hum.BodyDepthScale.Value = scales.Depth
			end

			if hum:FindFirstChild("HeadScale") then
				hum.HeadScale.Value = scales.Head
			end
		end)
	end
end

---------------------------------------------------
-- CLOTHES
---------------------------------------------------

local function applyClothes(shirtId,pantsId)

	local shirt = Instance.new("Shirt")
	shirt.ShirtTemplate =
	"http://www.roblox.com/asset/?id="..shirtId
	shirt.Parent = char

	local pants = Instance.new("Pants")
	pants.PantsTemplate =
	"http://www.roblox.com/asset/?id="..pantsId
	pants.Parent = char
end

---------------------------------------------------
-- APPLY OUTFIT
---------------------------------------------------

local function applyOutfit(data)

	LastOutfit = data

	clear()

	task.wait(0.1)

	applyHK()

	applyBody(data.Body,data.Scales)

	applyClothes(data.Shirt,data.Pants)

	for _,id in ipairs(data.Accessories) do
		equip(id)
		task.wait(0.25)
	end
end

